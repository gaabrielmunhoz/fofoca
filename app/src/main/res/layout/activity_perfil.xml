<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fofoca_fundo"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvVoltarPerfil"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="Voltar"
        android:textSize="15sp"
        android:textColor="@color/fofoca_rosa"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Meu perfil"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/fofoca_texto"/>

    <TextView
        android:id="@+id/tvNomePerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Carregando..."
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/fofoca_texto"/>

    <TextView
        android:id="@+id/tvUsuarioPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="16sp"
        android:textColor="@color/fofoca_rosa"/>

    <TextView
        android:id="@+id/tvEmailPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textSize="14sp"
        android:textColor="@color/fofoca_secundario"/>

</LinearLayout>