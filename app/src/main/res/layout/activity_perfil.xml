<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fofoca_fundo"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvVoltarPerfil"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="Ir para o feed"
        android:textSize="15sp"
        android:textColor="@color/fofoca_rosa"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Perfil"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/fofoca_texto"/>

    <TextView
        android:id="@+id/tvNomePerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Carregando..."
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/fofoca_texto"/>

    <TextView
        android:id="@+id/tvUsuarioPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="16sp"
        android:textColor="@color/fofoca_rosa"/>

    <TextView
        android:id="@+id/tvEmailPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textSize="14sp"
        android:textColor="@color/fofoca_secundario"
        android:visibility="gone"/>


    <LinearLayout
        android:id="@+id/layoutAcoesPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvEditarPerfil"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:background="@drawable/bg_acao_perfil"
                android:text="Editar perfil"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/fofoca_rosa"/>

            <TextView
                android:id="@+id/tvAlterarSenha"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:background="@drawable/bg_acao_perfil"
                android:text="Alterar senha"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/fofoca_rosa"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAlterarEmail"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:background="@drawable/bg_acao_perfil"
                android:text="Alterar e-mail"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/fofoca_rosa"/>

            <TextView
                android:id="@+id/tvExcluirConta"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:background="@drawable/bg_acao_perfil"
                android:text="Excluir conta"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#D32F2F"/>

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="@color/fofoca_secundario"
        android:alpha="0.25"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Fofocas"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/fofoca_texto"/>

    <TextView
        android:id="@+id/tvSemPostsPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Nenhuma fofoca publicada ainda."
        android:textSize="14sp"
        android:textColor="@color/fofoca_secundario"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPostsPerfil"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"/>

</LinearLayout>