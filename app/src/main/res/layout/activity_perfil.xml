<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fofoca_fundo"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvVoltarPerfil"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="Voltar"
        android:textSize="15sp"
        android:textColor="@color/fofoca_rosa"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Meu perfil"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/fofoca_texto"/>

    <TextView
        android:id="@+id/tvNomePerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Carregando..."
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/fofoca_texto"/>

    <TextView
        android:id="@+id/tvUsuarioPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="16sp"
        android:textColor="@color/fofoca_rosa"/>

    <TextView
        android:id="@+id/tvEmailPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textSize="14sp"
        android:textColor="@color/fofoca_secundario"/>

    <TextView
        android:id="@+id/tvEditarPerfil"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="Editar perfil"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/fofoca_rosa"/>

    <TextView
        android:id="@+id/tvAlterarSenha"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="Alterar senha"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/fofoca_rosa"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Minhas fofocas"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/fofoca_texto"/>

    <TextView
        android:id="@+id/tvSemPostsPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Nenhuma fofoca publicada ainda."
        android:textSize="14sp"
        android:textColor="@color/fofoca_secundario"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPostsPerfil"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"/>

</LinearLayout>