<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fofoca_fundo"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvVoltar"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="Voltar"
        android:textSize="15sp"
        android:textColor="@color/fofoca_rosa"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Comentários"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/fofoca_texto"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tvComentarios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etComentario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Escreva um comentário..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="300"
            android:textColor="@color/fofoca_texto"
            android:textColorHint="@color/fofoca_secundario"/>

        <Button
            android:id="@+id/btnEnviar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enviar"
            android:textAllCaps="false"
            android:backgroundTint="@color/fofoca_rosa"/>

    </LinearLayout>

</LinearLayout>