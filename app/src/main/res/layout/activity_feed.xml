<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fofoca_fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fofoca."
            android:textSize="30dp"
            android:textStyle="bold"
            android:textColor="@color/fofoca_rosa"/>

        <TextView
            android:id="@+id/tvPerfil"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Perfil"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/fofoca_rosa"/>

        <TextView
            android:id="@+id/tvSair"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Sair"
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/fofoca_rosa"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/fofoca_secundario"
        android:alpha="0.25"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPosts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:clipToPadding="false"/>

        <TextView
            android:id="@+id/tvVazio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="Ainda não há fofocas por aqui."
            android:textSize="16sp"
            android:textColor="@color/fofoca_secundario"/>

    </FrameLayout>

    <Button
        android:id="@+id/btnNovaFofoca"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="Nova fofoca"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/fofoca_rosa"/>

</LinearLayout>