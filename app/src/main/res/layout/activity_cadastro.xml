<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fofoca_fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fofoca."
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="@color/fofoca_rosa"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Todo mundo tem algo pra contar."
            android:textSize="14sp"
            android:textColor="@color/fofoca_secundario"
            android:gravity="center"
            android:layout_marginBottom="40dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Entre para a conversa!"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="@color/fofoca_texto" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crie sua conta e comece a fofocar."
            android:textSize="14sp"
            android:textColor="@color/fofoca_secundario"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/etNome"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Nome e sobrenome"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:padding="12dp"
            android:textColor="@color/fofoca_texto"
            android:textColorHint="@color/fofoca_secundario"
            android:backgroundTint="@color/fofoca_rosa"/>

        <EditText
            android:id="@+id/etUsuario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Escolha seu @usuário"
            android:inputType="text"
            android:singleLine="true"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:textColor="@color/fofoca_texto"
            android:textColorHint="@color/fofoca_secundario"
            android:backgroundTint="@color/fofoca_rosa"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="E-mail"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:textColor="@color/fofoca_texto"
            android:textColorHint="@color/fofoca_secundario"
            android:backgroundTint="@color/fofoca_rosa"/>

        <EditText
            android:id="@+id/etSenha"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Senha"
            android:inputType="textPassword"
            android:singleLine="true"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:textColor="@color/fofoca_secundario"
            android:backgroundTint="@color/fofoca_rosa"/>

        <EditText
            android:id="@+id/etConfirmarSenha"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Confirmar senha"
            android:inputType="textPassword"
            android:singleLine="true"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:textColor="@color/fofoca_secundario"
            android:backgroundTint="@color/fofoca_rosa"/>

        <Button
            android:id="@+id/btnCadastrar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Cadastrar"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/fofoca_rosa"
            android:layout_marginTop="28dp"/>

        <TextView
            android:id="@+id/tvVoltarLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Já tem uma conta? Entrar"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/fofoca_rosa"
            android:gravity="center"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

</ScrollView>